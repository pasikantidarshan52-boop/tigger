# Copy to .env and edit. (Or export these variables in your shell / Docker.)

# Which AI backend Tigger uses: gemini | anthropic | openai | demo
TIGGER_PROVIDER=demo

# API keys (only the one for your chosen provider is needed)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
# For any OpenAI-compatible server (Ollama, LM Studio, vLLM...):
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: a long random string for signing login tokens (auto-generated if left empty)
TIGGER_SECRET=

# Set to 0 to disable public sign-ups (admin creates users by script)
TIGGER_ALLOW_SIGNUP=1
